# Copy to frontend/.env to switch the app from mock mode to the real backend.
# Mock mode is the default (no file needed) — the app runs standalone with
# seeded data and the fixture voice result.

# --- Voice feature only (F1) -----------------------------------------------
# The voice backend is live NOW while the rest of the app is still mock.
# Set this to test the real Gemini → Groq → fixture pipeline with your mic.
VITE_VOICE_LIVE=true

# Where the backend lives (default http://localhost:8000)
VITE_API_URL=http://localhost:8000

# --- Full integration (later, when the whole backend exists) ---------------
# Flip this to false to point EVERY service at the real backend.
# VITE_MOCK_MODE=false
