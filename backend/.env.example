# ============================================================================
# Voice feature (F1) backend config — copy this file to `.env` and fill in.
# The server works WITHOUT any key: VOICE_ENGINE=fixture returns a hardcoded
# sample listing so the demo never breaks. Add keys to go live.
# ============================================================================

# Engine order: auto | gemini | groq | fixture
#   auto    → try Gemini, then Groq, then fixture (best for the demo)
#   gemini  → Gemini only, then fixture
#   groq    → Groq only, then fixture
#   fixture → always the hardcoded sample (zero network, for rehearsal)
VOICE_ENGINE=auto

# --- Gemini (one call: audio → JSON) -----------------------------------------
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ⚠️ NOT gemini-3.6-flash: that model line 500s on audio input (broken audio
# support). gemini-3.5-flash and gemini-2.5-flash both accept audio fine.
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (two calls: Whisper transcribe → Llama structure) ------------------
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# llama-3.3-70b-versatile was retired from Groq — gpt-oss-120b is the current
# free-tier JSON-mode model (verified: returns the contract JSON correctly).
GROQ_LLM_MODEL=openai/gpt-oss-120b

# --- Server ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Database (F18 reviews) --------------------------------------------------
# SQLite for dev — swap to PostgreSQL later (the models are portable).
DATABASE_URL=sqlite:///./hyperlocal.db

# --- Auth (F22) ----------------------------------------------------------------
# CHANGE THIS for anything beyond local testing — it signs every login token.
JWT_SECRET=dev-secret-change-me
RESET_TOKEN_TTL_MINUTES=30

# --- Email (forgot password) ---------------------------------------------------
# Free key: https://resend.com — without it, reset tokens are logged
# server-side and shown in the API response (dev fallback).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hyperlocal Tourism <onboarding@resend.dev>
